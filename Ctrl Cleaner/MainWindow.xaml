<Window x:Class="CtrlCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CTRL Cleaner"
        Width="900" Height="580"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="Black">

    <Window.Resources>
        <Style x:Key="CleanButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D0000"/>
            <Setter Property="Foreground" Value="#FF2222"/>
            <Setter Property="BorderBrush" Value="#FF2222"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="/Fonts/#Minecraft"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF2222"
                                                  BlurRadius="16"
                                                  ShadowDepth="0"
                                                  Opacity="0.7"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A0000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#330000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                                <Setter Property="Foreground" Value="#444444"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#444444"
                                                          BlurRadius="4"
                                                          ShadowDepth="0"
                                                          Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- VIDEO BACKGROUND mudo -->
        <MediaElement x:Name="BgVideo"
                      Stretch="UniformToFill"
                      IsMuted="True"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Opacity="0.40"/>

        <!-- Overlay escuro -->
        <Rectangle Fill="#BB000000"/>

        <!-- Layout principal -->
        <Grid Margin="36,24,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Header -->
                <RowDefinition Height="Auto"/>   <!-- Status -->
                <RowDefinition Height="160"/>    <!-- Log box — altura fixa pequena -->
                <RowDefinition Height="10"/>     <!-- Progress -->
                <RowDefinition Height="*"/>      <!-- Spacer -->
                <RowDefinition Height="56"/>     <!-- Botão -->
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <TextBlock Grid.Row="0"
                       Text="CTRL CLEANER"
                       FontFamily="/Fonts/#Minecraft"
                       FontSize="40"
                       Foreground="#FF2222"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF2222" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- STATUS -->
            <TextBlock x:Name="StatusLabel"
                       Grid.Row="1"
                       Text="[ READY ]"
                       FontFamily="/Fonts/#Minecraft"
                       FontSize="11"
                       Foreground="#881111"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14"/>

            <!-- LOG BOX pequeno -->
            <Border Grid.Row="2"
                    BorderBrush="#FF2222"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect Color="#FF2222" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
                <ScrollViewer x:Name="LogScroller"
                              Background="#0A0000"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="LogBox"
                               FontFamily="/Fonts/#Minecraft"
                               FontSize="13"
                               Foreground="#FF4444"
                               Padding="10,8"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"/>
                </ScrollViewer>
            </Border>

            <!-- PROGRESS BAR -->
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="3"
                         Height="6"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="#FF2222"
                         Background="#1A0000"
                         BorderBrush="#550000"
                         BorderThickness="1"
                         Margin="0,0,0,0"/>

            <!-- Spacer -->
            <Grid Grid.Row="4"/>

            <!-- BOTÃO CLEAN -->
            <Button x:Name="CleanBtn"
                    Grid.Row="5"
                    Content="[ CLEAN ]"
                    Style="{StaticResource CleanButtonStyle}"
                    Click="CleanBtn_Click"/>
        </Grid>
    </Grid>
</Window>
